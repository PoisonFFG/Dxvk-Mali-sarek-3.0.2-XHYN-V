diff -ruN orig/src/util/gtav_runtime_info_impl.h mod/src/util/gtav_runtime_info_impl.h
--- orig/src/util/gtav_runtime_info_impl.h	1970-01-01 00:00:00.000000000 +0000
+++ mod/src/util/gtav_runtime_info_impl.h	2026-11-25 05:53:47.722436883 +0000
@@ -0,0 +1,44 @@
+#pragma once
+// gtav_runtime_info.cpp
+// Экспорт, который требует лаунчер XHYN V от каждой DXVK-библиотеки:
+//   int gtav_dxvk_query_runtime_info(uint32_t abi, uint32_t size, void *out);
+// Подключается из dxgi/gtav_runtime_info.cpp (id 1) и d3d11/gtav_runtime_info.cpp (id 2).
+// Если у проекта есть version-script / .sym / .def со списком экспортов,
+// добавьте туда имя gtav_dxvk_query_runtime_info.
+#include <cstdint>
+#include <cstring>
+
+#ifndef GTAV_LIB_ID
+#error "Define GTAV_LIB_ID: 1 for libdxvk_dxgi.so, 2 for libdxvk_d3d11.so"
+#endif
+
+namespace {
+  struct GtavRuntimeInfo {
+    uint32_t structSize;   // 0x60
+    uint32_t abi;          // 1
+    uint32_t libraryId;    // 1 = dxgi, 2 = d3d11
+    uint32_t flags;        // 7
+    uint32_t unknownA;     // 8  (значение как в Sarek 1.14.0)
+    uint32_t unknownB;     // 4  (значение как в Sarek 1.14.0)
+    char     runtimeHash[72]; // 64 hex-символа + нули, как в 1.14.0
+  };
+  static_assert(sizeof(GtavRuntimeInfo) == 0x60, "лаунчер ждёт ровно 0x60 байт");
+}
+
+extern "C" __attribute__((visibility("default"), used))
+int gtav_dxvk_query_runtime_info(uint32_t abi, uint32_t size, void* out) {
+  if (abi != 1 || size < sizeof(GtavRuntimeInfo) || !out)
+    return 0;
+
+  GtavRuntimeInfo info = {};
+  info.structSize = sizeof(GtavRuntimeInfo);
+  info.abi        = 1;
+  info.libraryId  = GTAV_LIB_ID;
+  info.flags      = 7;
+  info.unknownA   = 8;
+  info.unknownB   = 4;
+  std::memcpy(info.runtimeHash,
+              "0793f3a57d48fd214a65ab506d1cf53385913011ae1080ecdca1b6c3732fadf2", 64);
+  std::memcpy(out, &info, sizeof(info));
+  return 1;
+}
